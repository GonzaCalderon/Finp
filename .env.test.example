# Variables de entorno para el entorno de TEST
# Copiá este archivo a .env.test.local y completá los valores reales.
# .env.test.local NO debe comitearse (ya está en .gitignore)

# ─── Base de datos de TEST ────────────────────────────────────────────────────
# Usá una DB separada para test. El nombre debe incluir e2e, test o ci y no
# puede coincidir con la base de .env.local.
MONGODB_URI=mongodb://localhost:27017/finp-test
# Confirmación explícita del nombre seleccionado en la ruta de MONGODB_URI.
E2E_DATABASE_NAME=finp-test

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=un-secreto-largo-para-test-local
NEXTAUTH_URL=http://localhost:3001
# Requerido por Auth.js cuando Playwright levanta el build con next start.
AUTH_TRUST_HOST=true

# ─── Usuario de test (E2E) ────────────────────────────────────────────────────
# El seed crea o repara este usuario y deriva otro usuario independiente para
# el smoke financiero.
TEST_USER_EMAIL=test@finp.dev
TEST_USER_PASSWORD=TestPass123!

# ─── Playwright ───────────────────────────────────────────────────────────────
# URL base de la app cuando se corre en modo CI (con servidor ya levantado)
PLAYWRIGHT_BASE_URL=http://localhost:3001
